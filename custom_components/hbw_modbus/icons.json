{
  "entity": {
    "button": {
      "search_new": {
        "default": "mdi:magnify-plus-outline"
      },
      "scan_bus": {
        "default": "mdi:magnify-scan"
      },
      "teach_start": {
        "default": "mdi:school-outline"
      },
      "teach_marker": {
        "default": "mdi:map-marker-check-outline"
      },
      "teach_abort": {
        "default": "mdi:cancel"
      }
    },
    "sensor": {
      "search_status": {
        "default": "mdi:radar",
        "state": {
          "running": "mdi:timer-sand",
          "nothing": "mdi:check-circle-outline",
          "found": "mdi:new-box",
          "other": "mdi:help-circle-outline",
          "error": "mdi:alert-circle-outline"
        }
      },
      "teach": {
        "default": "mdi:school-outline",
        "state": {
          "done": "mdi:check-circle-outline",
          "off": "mdi:school-outline"
        }
      }
    },
    "switch": {
      "always_on": {
        "default": "mdi:lock-outline",
        "state": {
          "on": "mdi:lock"
        }
      }
    },
    "select": {
      "channel_type": {
        "default": "mdi:toggle-switch-outline",
        "state": {
          "light": "mdi:lightbulb-outline"
        }
      }
    }
  }
}
